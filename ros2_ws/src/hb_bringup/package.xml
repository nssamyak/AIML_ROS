<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hb_bringup</name>
  <version>1.0.0</version>
  <description>One-command launches for the HB bot in simulation and on the real robot</description>
  <maintainer email="nssamyakvarma@gmail.com">Athena workshop</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hb_description</exec_depend>
  <exec_depend>hb_control</exec_depend>
  <exec_depend>hb_gazebo</exec_depend>
  <exec_depend>hb_navigation</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
