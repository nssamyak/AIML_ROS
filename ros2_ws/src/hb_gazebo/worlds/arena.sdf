<?xml version="1.0"?>
<!--
  Workshop arena: 4 m x 3 m, three rooms joined by doorways, a few obstacles.
  Walls are 0.3 m tall, well above the lidar scan plane (~0.12 m).
  The robot spawns at (-1.3, -0.2).
-->
<sdf version="1.9">
  <world name="arena">

    <!-- Rollers are tiny, so use a 1 ms physics step -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- All walls and obstacles live in one static model -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">

        <!-- Outer walls -->
        <collision name="north_c"><pose>0 1.525 0.15 0 0 0</pose><geometry><box><size>4.1 0.05 0.3</size></box></geometry></collision>
        <visual name="north_v"><pose>0 1.525 0.15 0 0 0</pose><geometry><box><size>4.1 0.05 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material></visual>

        <collision name="south_c"><pose>0 -1.525 0.15 0 0 0</pose><geometry><box><size>4.1 0.05 0.3</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -1.525 0.15 0 0 0</pose><geometry><box><size>4.1 0.05 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material></visual>

        <collision name="east_c"><pose>2.025 0 0.15 0 0 0</pose><geometry><box><size>0.05 3.0 0.3</size></box></geometry></collision>
        <visual name="east_v"><pose>2.025 0 0.15 0 0 0</pose><geometry><box><size>0.05 3.0 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material></visual>

        <collision name="west_c"><pose>-2.025 0 0.15 0 0 0</pose><geometry><box><size>0.05 3.0 0.3</size></box></geometry></collision>
        <visual name="west_v"><pose>-2.025 0 0.15 0 0 0</pose><geometry><box><size>0.05 3.0 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material></visual>

        <!-- Inner walls (doorways are at least 0.8 m wide) -->
        <collision name="wall_a_c"><pose>-0.6 -0.4 0.15 0 0 0</pose><geometry><box><size>0.05 2.2 0.3</size></box></geometry></collision>
        <visual name="wall_a_v"><pose>-0.6 -0.4 0.15 0 0 0</pose><geometry><box><size>0.05 2.2 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.3 1</ambient><diffuse>0.6 0.6 0.3 1</diffuse></material></visual>

        <collision name="wall_b_c"><pose>1.2 0.2 0.15 0 0 0</pose><geometry><box><size>1.6 0.05 0.3</size></box></geometry></collision>
        <visual name="wall_b_v"><pose>1.2 0.2 0.15 0 0 0</pose><geometry><box><size>1.6 0.05 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.3 1</ambient><diffuse>0.6 0.6 0.3 1</diffuse></material></visual>

        <collision name="wall_c_c"><pose>1.0 -1.05 0.15 0 0 0</pose><geometry><box><size>0.05 0.9 0.3</size></box></geometry></collision>
        <visual name="wall_c_v"><pose>1.0 -1.05 0.15 0 0 0</pose><geometry><box><size>0.05 0.9 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.3 1</ambient><diffuse>0.6 0.6 0.3 1</diffuse></material></visual>

        <!-- Obstacles -->
        <collision name="box1_c"><pose>0.0 -0.6 0.15 0 0 0.3</pose><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="box1_v"><pose>0.0 -0.6 0.15 0 0 0.3</pose><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material></visual>

        <collision name="box2_c"><pose>-1.5 -1.0 0.15 0 0 0</pose><geometry><box><size>0.25 0.4 0.3</size></box></geometry></collision>
        <visual name="box2_v"><pose>-1.5 -1.0 0.15 0 0 0</pose><geometry><box><size>0.25 0.4 0.3</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material></visual>

        <collision name="cyl1_c"><pose>-1.3 0.9 0.15 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="cyl1_v"><pose>-1.3 0.9 0.15 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>

        <collision name="cyl2_c"><pose>1.4 0.9 0.15 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="cyl2_v"><pose>1.4 0.9 0.15 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>

      </link>
    </model>

  </world>
</sdf>
